NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=development-only-secret-at-least-32-characters

DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379

# Google OAuth is disabled in development when both values are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Relay <no-reply@relay.local>

UPLOAD_DIR=./storage/uploads
LOG_LEVEL=info
TRUST_PROXY=false
